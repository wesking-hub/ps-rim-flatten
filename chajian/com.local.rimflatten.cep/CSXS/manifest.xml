<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="7.0"
  ExtensionBundleId="com.local.rimflatten.cep"
  ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="rim-flatten"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <ExtensionList>
    <Extension Id="com.local.rimflatten.cep.panel" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[18.0,99.9]" />
      <Host Name="PHSP" Version="[18.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.local.rimflatten.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--high-dpi-support=1</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--disable-accelerated-video-decode</Parameter>
            <Parameter>--disable-threaded-scrolling</Parameter>
            <Parameter>--disable-pinch</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <HideOnClose>true</HideOnClose>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>文字边缘修复 rim-flatten</Menu>
          <Geometry>
            <Size>
              <Width>300</Width>
              <Height>460</Height>
            </Size>
            <MinSize>
              <Width>260</Width>
              <Height>340</Height>
            </MinSize>
            <MaxSize>
              <Width>1200</Width>
              <Height>1200</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
